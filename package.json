{
  "name": "clipmax-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Clipmax Pro — local-first clipper studio that finds the moment, cuts it, captions it, and queues it for every platform.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,magenta \"node server/index.js\" \"vite --port 5173 --strictPort\"",
    "api": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js --serve-build",
    "desktop": "electron electron/main.cjs",
    "desktop:build": "npm run build && electron-builder",
    "youtube:auth": "node scripts/youtube-auth.mjs",
    "test": "node --test test/*.test.js",
    "design": "node \"C:/Users/Philomena Osei Bonsu/.agents/skills/hallmark/scripts/sloplint.mjs\" src --scope app"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource/anton": "^5.1.1",
    "@huggingface/transformers": "^4.3.2",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "onnxruntime-node": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.11"
  },
  "build": {
    "appId": "studio.clipmax.pro",
    "productName": "Clipmax Pro",
    "asar": false,
    "files": [
      "electron/**",
      "server/**",
      "shared/**",
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron@33.4.11": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true
  }
}
